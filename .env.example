# Public Supabase settings. In Coolify, enable "Build Variable" for both.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only Supabase settings.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Stripe server credentials.
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Protects /api/keep-alive. Generate a long random value.
CRON_SECRET=replace-with-a-long-random-value

# Optional: only needed for listing enrichment and scraping.
GEMINI_API_KEY=
APIFY_API_TOKEN=
